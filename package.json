{
  "name": "whichpeak",
  "version": "0.1.0",
  "description": "Name every mountain on the horizon from real terrain data, in your browser",
  "type": "module",
  "license": "MIT",
  "author": "Arthur031221",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur031221/WhichPeak.git"
  },
  "homepage": "https://arthur031221.github.io/WhichPeak/",
  "bugs": {
    "url": "https://github.com/Arthur031221/WhichPeak/issues"
  },
  "keywords": [
    "mountains",
    "peaks",
    "panorama",
    "dem",
    "terrain",
    "peakfinder",
    "hiking",
    "viewshed"
  ],
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/suncalc": "^1.9.2",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "suncalc": "^2.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
